# Configuracao unica do ambiente FIAP X.
# Copie para .env antes de subir o compose:  cp .env.example .env
# Gere valores proprios para APP_KEY e JWT_SECRET antes de qualquer uso real.

APP_NAME="FIAP X"
APP_ENV=local
APP_KEY=base64:COLOQUE_UMA_CHAVE_DE_32_BYTES_EM_BASE64
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=debug

# ---- Banco de dados ----
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fiapx
DB_USERNAME=fiapx
DB_PASSWORD=fiapx

# ---- Cache / sessao ----
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=sync

# ---- Autenticacao ----
JWT_SECRET=COLOQUE_UM_SEGREDO_LONGO_E_ALEATORIO
JWT_TTL_MINUTES=120
JWT_ISSUER=fiapx-api

# ---- Mensageria ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=fiapx
RABBITMQ_PASSWORD=fiapx
RABBITMQ_VHOST=/

# ---- Storage de objetos (MinIO local / S3 em nuvem) ----
STORAGE_DISK=s3
STORAGE_PUBLIC_DISK=s3_public
STORAGE_BUCKET=fiapx-videos
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=fiapxadmin
STORAGE_SECRET_KEY=fiapxadmin123
# Endpoint interno, usado pela API e pelo worker dentro da rede do Docker.
STORAGE_ENDPOINT=minio:9000
STORAGE_ENDPOINT_URL=http://minio:9000
# Endpoint que o navegador do usuario alcanca, usado para assinar os downloads.
STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
STORAGE_PATH_STYLE=true
STORAGE_USE_SSL=false

# ---- Processamento ----
PROCESSING_FPS=1
UPLOAD_MAX_SIZE_KB=512000
DOWNLOAD_URL_TTL_MINUTES=15
# Jobs simultaneos por replica do worker.
WORKER_PREFETCH=2
WORKER_MAX_RETRY=3

# ---- Notificacoes ----
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=nao-responda@fiapx.local
MAIL_FROM_NAME="FIAP X"

# ---- Observabilidade ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3001
