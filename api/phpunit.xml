<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <!-- Adaptadores de infraestrutura: exigem broker real, cobertos
                 pelos testes de integracao do ambiente completo. -->
            <directory>app/Messaging</directory>
            <file>app/Console/Commands/ConsumeStatusEvents.php</file>
            <directory>app/Providers</directory>
        </exclude>
    </source>
    <coverage>
        <report>
            <clover outputFile="coverage.xml"/>
            <text outputFile="php://stdout" showOnlySummary="true"/>
        </report>
    </coverage>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:aGFja2F0aG9uLWZpYXB4LXBvc3RlY2gtMTNzb2F0ISE="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>

        <!-- Configuracao propria da FIAP X para a suite -->
        <env name="JWT_SECRET" value="segredo-de-teste-nao-usar-em-producao"/>
        <env name="JWT_TTL_MINUTES" value="120"/>
        <env name="STORAGE_DISK" value="local"/>
        <env name="STORAGE_PUBLIC_DISK" value="local"/>
        <env name="STORAGE_BUCKET" value="fiapx-videos"/>
    </php>
</phpunit>
