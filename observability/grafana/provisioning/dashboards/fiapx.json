{
  "uid": "fiapx-visao-geral",
  "title": "FIAP X · Processamento de vídeos",
  "description": "Fila, processamento e resultado dos vídeos. As cores seguem o estado (na fila, processando, pronto, falha) e não a ordem das séries.",
  "tags": ["fiapx"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "Agora",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Na fila",
      "description": "Vídeos aceitos que ainda não começaram a ser processados. É este número que sobe quando o worker está fora do ar.",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(fiapx_videos_total{status=\"PENDING\"})",
          "instant": true,
          "legendFormat": "na fila"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "value",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Processando",
      "description": "Vídeos sendo processados neste instante, somando todas as réplicas do worker.",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(fiapx_videos_em_processamento)",
          "instant": true,
          "legendFormat": "processando"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "orange", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "textMode": "value",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Prontos",
      "description": "Vídeos processados com sucesso, com o ZIP disponível para download.",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(fiapx_videos_total{status=\"COMPLETED\"})",
          "instant": true,
          "legendFormat": "prontos"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "textMode": "value",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Com falha",
      "description": "Vídeos que esgotaram as tentativas. Cada um destes gerou uma notificação por e-mail ao usuário.",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 15, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(fiapx_videos_total{status=\"FAILED\"})",
          "instant": true,
          "legendFormat": "falhas"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "textMode": "value",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Réplicas do worker",
      "description": "Quantas instâncias do worker estão de pé e publicando métricas.",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=\"fiapx-worker\"} == 1) or vector(0)",
          "instant": true,
          "legendFormat": "réplicas"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "text", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },

    {
      "type": "row",
      "title": "Fila e vazão",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Fila de processamento",
      "description": "Mensagens aguardando na fila contra as que estão sendo processadas. Ao derrubar o worker, a linha de aguardando sobe e nada se perde.",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rabbitmq_queue_messages_ready{queue=\"video.processing\"})",
          "legendFormat": "aguardando na fila"
        },
        {
          "refId": "B",
          "expr": "sum(rabbitmq_queue_messages_unacked{queue=\"video.processing\"})",
          "legendFormat": "em processamento"
        },
        {
          "refId": "C",
          "expr": "sum(rabbitmq_queue_messages_ready{queue=\"video.processing.dlq\"})",
          "legendFormat": "na dead letter queue"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "lineInterpolation": "stepAfter",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "aguardando na fila" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "em processamento" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "na dead letter queue" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Resultado do processamento",
      "description": "Vídeos finalizados por minuto, separados por desfecho. Falha transitória é uma tentativa que será repetida; falha permanente é o que foi para a DLQ e gerou notificação.",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (resultado) (rate(fiapx_videos_processados_total[1m])) * 60",
          "legendFormat": "{{resultado}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "sucesso" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "falha_transitoria" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "falha_permanente" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },

    {
      "type": "row",
      "title": "Desempenho",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tempo de processamento por vídeo",
      "description": "Do download do vídeo até o upload do ZIP. A mediana mostra o caso comum; o percentil 95 mostra os vídeos mais pesados.",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(fiapx_processamento_duracao_segundos_bucket[5m])))",
          "legendFormat": "mediana"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fiapx_processamento_duracao_segundos_bucket[5m])))",
          "legendFormat": "percentil 95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "mediana" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "percentil 95" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "bargauge",
      "title": "Vídeos por situação",
      "description": "Distribuição atual da carteira do sistema.",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 8, "w": 7, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (fiapx_videos_total)",
          "instant": true,
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "COMPLETED" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "PROCESSING" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "FAILED" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "PENDING" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }]
          }
        ]
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Frames por vídeo",
      "description": "Média de frames extraídos. A 1 frame por segundo, equivale à duração média dos vídeos enviados.",
      "datasource": { "type": "prometheus", "uid": "fiapx-prometheus" },
      "gridPos": { "h": 8, "w": 5, "x": 19, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(fiapx_frames_por_video_sum) / clamp_min(sum(fiapx_frames_por_video_count), 1)",
          "instant": true,
          "legendFormat": "média"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "textMode": "value_and_name",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    }
  ]
}
